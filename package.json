    "test": "node --test tests/*.test.mjs",
    "data:sync": "node scripts/sync-prts.mjs",
    "data:check": "node scripts/prts-db.mjs validate",
    "data:stats": "node scripts/prts-db.mjs stats",
    "data:sqlite": "node scripts/prts-db.mjs sqlite",
    "data:query": "node scripts/prts-db.mjs",
    "dev": "node scripts/serve.mjs",
    "data:fetch-game": "node scripts/fetch-game-data.mjs",
    "data:normalize": "node scripts/normalize-game-data.mjs",
    "data:normalized-sqlite": "node scripts/build-normalized-db.mjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "data:fetch-mode": "node scripts/fetch-alliance-data.mjs && node scripts/fetch-alliance-levels.mjs",
    "test:deployment": "node scripts/deployment-browser.cjs",
    "test:season": "node scripts/season-browser.cjs",
