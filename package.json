{
  "name": "garrison-protocol-fan-game",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-unlock-manifest.mjs && node scripts/build-operator-adapter-manifest.mjs && node scripts/build-protocol.mjs && node scripts/build-native.mjs && node scripts/build-token-data.mjs && node scripts/build-catalog.mjs && node scripts/build-wave-defaults.mjs && node scripts/build-browser.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:regression": "node scripts/regression-browser.mjs",
    "test:browser": "node scripts/regression-browser.mjs smoke",
    "test:combat": "node scripts/regression-browser.mjs combat",
    "test:effects": "node scripts/regression-browser.mjs effects",
    "test:layout": "node scripts/regression-browser.mjs layout",
    "test:fx-preview": "node scripts/regression-browser.mjs fx-preview",
    "test:mobile-bonds": "node scripts/regression-browser.mjs mobile-bonds",
    "data:sync": "node scripts/sync-prts.mjs",
    "data:check": "node scripts/prts-db.mjs validate",
    "data:stats": "node scripts/prts-db.mjs stats",
    "data:sqlite": "node scripts/prts-db.mjs sqlite",
    "data:query": "node scripts/prts-db.mjs",
    "dev": "node scripts/serve.mjs",
    "data:fetch-game": "node scripts/fetch-game-data.mjs",
    "data:normalize": "node scripts/normalize-game-data.mjs",
    "data:normalized-sqlite": "node scripts/build-normalized-db.mjs",
    "data:fetch-mode": "node scripts/fetch-alliance-data.mjs && node scripts/fetch-alliance-levels.mjs",
    "release:check": "node scripts/check-release.mjs",
    "data:assets": "node scripts/sync-mode-assets.mjs",
    "data:animations:sync": "node scripts/sync-operator-animations.mjs",
    "data:animations:check": "node scripts/operator-animations.mjs validate",
    "data:animations": "node scripts/operator-animations.mjs",
    "data:branches": "node scripts/fetch-branch-sources.mjs && node scripts/build-branch-records.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
